# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit a filled-in file: .gitignore
# blocks every .env* except this one.
# ---------------------------------------------------------------------------

# Where the app is reachable. Referral links are built from it, so it must be
# the public origin, not localhost, in production. A trailing slash is stripped.
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://referrals:referrals@localhost:5433/referrals

# --- Stripe -----------------------------------------------------------------
# Test keys start with sk_test_. Use a test key until you have run the
# checklist in the README once.
STRIPE_SECRET_KEY=sk_test_replace_me

# From `stripe listen` locally, or from the Stripe dashboard for a deployed
# endpoint. Without it the webhook route refuses every request, which is the
# safe direction: an unverified webhook must never move a discount.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# The price the demo checkout sells. Any recurring price in your account.
STRIPE_PRICE_ID=price_replace_me

# --- Referral program -------------------------------------------------------
# Percent off per active referral, and how many referrals still earn one.
# REFERRAL_PERCENT_STEP * REFERRAL_MAX_REFERRALS must be <= 100, or the app
# refuses to start: Stripe has no coupon above 100 percent off.
#
#   20 x 5  -> each referral takes 20% off, five make the subscription free
#   10 x 5  -> a gentler program that caps at half price
#   25 x 2  -> two referrals, half price, nothing beyond
REFERRAL_PERCENT_STEP=20
REFERRAL_MAX_REFERRALS=5

# Does a referral still inside its free trial count towards the discount?
# Leave false. This single flag is what stops a trial farm from making a
# subscription free without anyone ever paying. See the README's abuse section.
REFERRAL_COUNT_TRIALING=false

# Prefix for the coupons this app creates in your Stripe account. The percent
# is appended, so the ids read `referral_off_20`, `referral_off_40`, and a
# coupon can never be reused for a percentage it was not created with.
REFERRAL_COUPON_PREFIX=referral_off

# Cookie lifetime, in days, for a referral code captured from a ?ref= link
# before the visitor signs up.
REFERRAL_COOKIE_DAYS=30
